# Optional: TypeSafe Jev API routing (--use-jev)
TYPESAFE_API_KEY=

# Deepgram speech-to-text (preferred when set; MAC_VOICE_STT=auto)
DEEPGRAM_API_KEY=

# Command Code Provider API (Muse / DeepSeek / free models)
# Also accepted: CMD_API_KEY
COMMAND_CODE_API_KEY=

# Default LLM for --use-llm and code dictation normalize
MAC_VOICE_MODEL=meta/muse-spark-1.3-contributor
# Examples:
#   MAC_VOICE_MODEL=deepseek/deepseek-v4-flash
#   MAC_VOICE_MODEL=poolside/laguna-s-2.1-free
#   MAC_VOICE_MODEL=inclusionai/ling-3.1-flash:free

# STT: auto | deepgram | whisper  (auto uses Deepgram when DEEPGRAM_API_KEY is set)
MAC_VOICE_STT=auto

# Set to 1 to enable Command Code LLM routing by default
MAC_VOICE_USE_LLM=0

# Optional legacy Muse/Anthropic key for code dictation only (Command Code preferred)
# MUSE_API_KEY=

# MAC_VOICE_WAKE_WORD=Alfred
# MAC_VOICE_DRY_RUN=0
